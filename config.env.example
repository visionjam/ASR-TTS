# 复制本文件为 config.env，填一个 Key 就够。
# 转写和整理都走 DeepSeek，同一个 Key、同一份账单。
#
# 注意：config.env 在手机共享存储里，其他 App 理论上可读。
# 不要同步到网盘，不要发给别人；Key 泄露就去控制台重置。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 整理用的模型。账号下有 deepseek-chat / deepseek-flash / deepseek-v4-pro
LLM_MODEL=deepseek-chat

# 额外扫描目录（逗号分隔）。录音机默认存这里，脚本会自动复制到 inbox/，
# 原文件留在录音机里不动。不想要就留空。
EXTRA_DIRS=/storage/emulated/0/Music/Recordings

# ---- 豆包语音合成 2.0（可选，不填就走 DeepSeek）----
# 豆包语音控制台 > API Key 管理 建的那串 UUID，对应请求头 X-Api-Key。
# 注意：方舟（Ark）的 Key 不通用；也别忘了先在控制台开通「语音合成大模型」。
DOUBAO_API_KEY=

# 切默认供应商：deepseek / doubao。不写就是 deepseek。
# TTS_PROVIDER=doubao
# DOUBAO_VOICE=zh_male_liufei_uranus_bigtts
# 语速 [-50,100]，0 默认。豆包默认约 300 字/分，-20 更像播客。
# DOUBAO_SPEECH_RATE=-20

# ---- 本地 Kokoro 服务（可选，仅 PC，费用 0）----
# 先跑 tools/local-tts/start.cmd 把服务起起来，再 --provider local。
# 手机上没有这个服务，别在手机上选它。
# LOCAL_TTS_URL=http://127.0.0.1:1919
# LOCAL_VOICE=auto            # auto 按语言选：中文 zf_001 / 英文 af_heart

# ---- 读法层（进 TTS 之前的符号和标记处理）----
# 默认开。把引擎念不出来的写法换掉（实测只剩 → 被读成「右箭头」），
# 并把代码块、表格、长 URL、（原文：…）夹注摘到成品目录的「原文附录.md」。
# 要全局关掉写 0；单次临时关用 --no-verbalize。
# CAST_VERBALIZE=0
