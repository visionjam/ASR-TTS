# PC 端模板：复制为数据目录（ASRTTS/）下的 config.env，填一个 Key 就够。
# 转写和整理都走 DeepSeek，同一个 Key、同一份账单。
#
# 这个文件跟着导出件到处走，所以别往里填真 Key。
# 真 Key 只写在本机的 config.env，或走环境变量 DEEPSEEK_API_KEY。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 整理用的模型。账号下有 deepseek-chat / deepseek-flash / deepseek-v4-pro
LLM_MODEL=deepseek-chat

# 额外扫描目录（逗号分隔）：录音机/会议软件的落盘位置，脚本会把新文件复制进 inbox/，
# 原文件不动。不用就留空。Windows 路径用正斜杠。
# Linux:   EXTRA_DIRS=/home/me/Music/Recordings
# Windows: EXTRA_DIRS=D:/Recordings
# macOS:   EXTRA_DIRS=/Users/me/Music/Recordings
EXTRA_DIRS=
